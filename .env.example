# ---------- App ----------
NODE_ENV=production
PORT=4000
BRAND_NAME=WappFlow
# Public URL of the dashboard and of this API (same domain when the API serves web/dist)
APP_URL=https://wa.example.com
API_URL=https://wa.example.com
# Public website (wappflow-web), so its pricing section can load your plans. Comma separated.
SITE_URL=https://wappflow.com,https://www.wappflow.com

# Generate both with:  openssl rand -base64 48
JWT_SECRET=change-me
# Encrypts stored WhatsApp tokens. NEVER change it after go-live or saved tokens become unreadable.
APP_KEY=change-me

# ---------- Database ----------
# SQLite (default, fine for a pilot): leave DB_CLIENT empty.
# MySQL / MariaDB:
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wappflow
DB_PASSWORD=change-me
DB_NAME=wappflow
# PostgreSQL: DB_CLIENT=pg and DATABASE_URL=postgres://user:pass@host/db

# ---------- Meta / WhatsApp Cloud API ----------
META_GRAPH_VERSION=v23.0
# Your Meta app (developers.facebook.com). APP_SECRET verifies webhook signatures.
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value in Meta → WhatsApp → Configuration → Verify token
META_VERIFY_TOKEN=change-me
# Embedded Signup configuration id (only after Meta approves you as a Tech Provider)
META_ES_CONFIG_ID=

# ---------- Billing ----------
# free trial days; 0 = no trial: new workspaces explore with a demo number and go live after paying
TRIAL_DAYS=0
# days a workspace keeps working after its plan ends unpaid (0 = locked until paid)
GRACE_DAYS=0
# PayPal: developer.paypal.com → Apps & Credentials. Empty = PayPal hidden.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox while testing, live for real payments
PAYPAL_MODE=sandbox
# PayPal cannot charge KWD: invoices are converted to this currency at PAYPAL_FX_RATE per 1 KWD
PAYPAL_CURRENCY=USD
PAYPAL_FX_RATE=3.26

# Tap Payments secret key (sk_live_... / sk_test_...). Empty = bank transfer only.
TAP_SECRET_KEY=
# Shown to customers when online payment is off
BANK_DETAILS="Bank transfer to Teknulugy · IBAN KW00 XXXX 0000 0000 0000 0000 0000 00 · send the receipt to billing@example.com"

# ---------- Platform admin (used by `npm run seed`) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---------- Admin dashboard ----------
# Built admin dashboard (wappflow-admin repo → npm run build). Default: ../wappflow-admin/dist
# WEB_DIST=/var/www/wappflow-admin/dist

# ---------- Tuning ----------
SEND_RATE_PER_SEC=20
ALLOW_SIGNUP=true
# Set WORKER=false on extra API instances so only one process runs background jobs
WORKER=true
